# ==============================================================================
# Production Environment Configuration
# ==============================================================================

# Project & Metadata
PROJECT_NAME="Wi-Fi Classroom Presence Estimation"
VERSION="0.1.0"
ENVIRONMENT="production"

# Server Network Settings (Recommended: 2+ workers for production)
HOST="0.0.0.0"
PORT=8000
WORKERS=2
RELOAD=false

# Database Connection (Persistent volume path)
DATABASE_URL="sqlite:////app/database/wifi_presence.db"

# Security & CORS (Replace with your actual production frontend domains)
# Example: "https://wifi.yourdomain.com,https://dashboard.yourdomain.com"
CORS_ORIGINS="*"

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
