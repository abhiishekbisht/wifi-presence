# ==============================================================================
# Development Environment Configuration
# ==============================================================================

# Project & Metadata
PROJECT_NAME="Wi-Fi Classroom Presence Estimation"
VERSION="0.1.0"
ENVIRONMENT="development"

# Server Network Settings
HOST="0.0.0.0"
PORT=8000
WORKERS=1
RELOAD=true

# Database Connection (SQLite URI or file path)
DATABASE_URL="sqlite:///database/wifi_presence.db"

# Security & CORS (Comma-separated list of allowed origins or '*' for wildcards)
CORS_ORIGINS="*"

# Logging
LOG_LEVEL="INFO"
