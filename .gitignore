htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (Keep templates tracked, ignore real secrets)
.env
.env.local
.env.*.local
.env.production
!.env.example
!.env.production.example

# SSL Certificates & Private Keys (NEVER commit secrets/keys)
deploy/ssl/
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12

# SQLite Databases & Backups (Runtime generated files)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3
database/*.db
database/backups/
*.db.gz

# Application Logs
*.log
logs/
/var/log/

# Docker Local Overrides
docker-compose.override.yml

# IDE & Editor specific files
.idea/
.vscode/
*.swp
*.swo
*~

